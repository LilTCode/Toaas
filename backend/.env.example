# ---------------------------------------------------------------------------
# Local development. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-this-with-a-secure-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local MySQL. Used only when DATABASE_URL is absent.
MYSQL_DATABASE=toaas
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ---------------------------------------------------------------------------
# Production (Vercel). Set these in the Vercel dashboard, not in this file.
# ---------------------------------------------------------------------------
# Injected automatically when you attach Neon Postgres to the project.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Injected automatically when you attach a Vercel Blob store. Its presence is
# what switches media uploads from the local filesystem to Blob storage.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Comma-separated, no trailing slash. Required so the browser can call the API
# cross-origin and so Django accepts admin logins over https.
# CORS_ALLOWED_ORIGINS=https://your-frontend-project.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-frontend-project.vercel.app
# DJANGO_ALLOWED_HOSTS=your-backend-project.vercel.app
# DJANGO_DEBUG=False

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
AI_API_KEY=your_openai_api_key
AI_API_URL=https://api.openai.com/v1/responses
OPENAI_MODEL=gpt-4o-mini
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_institutional_email@example.com
EMAIL_HOST_PASSWORD=your_email_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TO-AAS <your_institutional_email@example.com>
