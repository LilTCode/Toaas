# Local development: leave blank/relative so Vite's dev proxy forwards /api to
# 127.0.0.1:8000 (see vite.config.js).
VITE_API_BASE_URL=/api/

# Production: set this in the Vercel frontend project's environment variables
# to the deployed backend, including the trailing /api/ and slash.
# VITE_API_BASE_URL=https://your-backend-project.vercel.app/api/
